server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Forward API calls to the backend (target set by the API_URL env var)
  location /health {
    proxy_pass ${API_URL};
  }

  # Single-page app: unknown paths fall back to index.html
  location / {
    try_files $uri /index.html;
  }
}